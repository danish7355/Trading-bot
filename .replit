run = "node server.js"
language = "nodejs"
modules = ["nodejs-24"]

[nix]
channel = "stable-22_11"

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AlgoBot"

[[workflows.workflow]]
name = "AlgoBot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
